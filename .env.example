# Every value here is also a default in env.sh; export only what you need to change.
# Copy to .env and source it before calling the scripts, or export inline.

# Where the recipe lives (venv, runtime checkout, state, models)
RECIPE_HOME=$HOME/mimo-exl3

# The runtime: vcruz305/exllamav3. Pin the released wheel tag, or a commit for --from-source.
EXL3_WHEEL_TAG=v1.5.1.post1
EXL3_MIN_VERSION=1.5.1.post1
EXL3_REF=master

# The pack. 2.20 bpw is the rung that fits one 96 GB card;
# 2.50 bpw is published and does not fit. Override PACK_DIR for a pack you already have.
PACK_REPO=vcruz305/MiMo-V2.6-Flash-RL-EXL3
PACK_SUBDIR=2.20bpw
# PACK_DIR=$RECIPE_HOME/models/MiMo-V2.6-Flash-RL-EXL3/2.20bpw

# The DFlash drafter ships in the original checkpoint; fix_dflash.py corrects a copy of it.
BASE_MODEL_REPO=XiaomiMiMo/MiMo-V2.6-Flash-RL
DRAFT_SUBDIR=dflash
# DRAFT_SRC=$RECIPE_HOME/models/MiMo-V2.6-Flash-RL/dflash
# DRAFT_DIR=$RECIPE_HOME/models/MiMo-V2.6-Flash-RL-dflash-fixed

# The API surface
HOST=127.0.0.1
PORT=8096
SERVED_NAME=MiMo-V2.6-Flash-RL-EXL3

# Sizing (the measured configuration; see configs/ for why)
CTX=65536
CACHE_SIZE=65536
AUTOSPLIT_MAX_BATCH=16
MAX_ACTIVE_REQUESTS=16
MAX_PENDING_REQUESTS=64

# Set to 1 to print the serve command instead of running it
DRY_RUN=

# Toolchain, for --from-source only
CUDA_HOME=/usr/local/cuda
TORCH_CUDA_ARCH_LIST=12.0
