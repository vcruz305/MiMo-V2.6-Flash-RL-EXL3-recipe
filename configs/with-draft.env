# Measured with-draft profile: the 184.46 tok/s p50 decode figure in README "Measured
# results" was taken on this configuration, same card, same pack, same day as no-draft.env.
# The only difference is -dm: the CORRECTED copy of the DFlash draft folder.
#
# Sourced by serve.sh after env.sh (PROFILE=with-draft, the default). DRAFT_DIR comes from
# env.sh; run setup.sh (or python tools/fix_dflash.py) to build it.

CTX=65536
CACHE_SIZE=65536
AUTOSPLIT_MAX_BATCH=16
MAX_ACTIVE_REQUESTS=16
MAX_PENDING_REQUESTS=64
DRAFT=1              # -dm "$DRAFT_DIR": draft length is the drafter's own default (7)
