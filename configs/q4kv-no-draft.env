# Q4-KV profile, no drafter. This is the configuration behind the 49.73 tok/s p50 decode figure and
# the 1,048,576-token context ceiling in README "Best measured configuration (Q4 KV)" — the largest
# context this pack serves on one 96 GB card. Client-observed SixCat speed, not a server counter.
#
# Sourced by serve.sh after env.sh (PROFILE=q4kv-no-draft). CHUNK_SIZE is the loader-transient
# lever: 4096 recovers prefill speed here, and it costs no decode.

CTX=1048576
CACHE_SIZE=1048576
KV_CACHE_Q=4
CHUNK_SIZE=4096
AUTOSPLIT_MAX_BATCH=16
MAX_ACTIVE_REQUESTS=16
MAX_PENDING_REQUESTS=64
DRAFT=0
