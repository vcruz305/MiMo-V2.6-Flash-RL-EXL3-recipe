# Q4-KV profile, with the EXL3 drafter. This is the configuration behind the 201.06 tok/s p50
# decode figure and the 655,360-token with-drafter context ceiling in README
# "Best measured configuration (Q4 KV)". Client-observed SixCat speed, not a server counter.
#
# Sourced by serve.sh after env.sh (PROFILE=q4kv-with-draft). DRAFT_DIR comes from env.sh, which
# prefers the EXL3 4.0 bpw drafter and falls back to the corrected BF16 one; build the quantized
# copy with tools/quantize_dflash.sh (it is what buys the decode and the extra context).
#
# Note: -cq 4 changes the numerics. The pack's top-1/KLD figures in README "Quants" were measured
# with FP16 KV; the default-120 eval was re-run on this profile and scored 70.0 (120/120 scored).

CTX=655360
CACHE_SIZE=655360
KV_CACHE_Q=4
CHUNK_SIZE=2048
AUTOSPLIT_MAX_BATCH=16
MAX_ACTIVE_REQUESTS=16
MAX_PENDING_REQUESTS=64
DRAFT=1              # -dm "$DRAFT_DIR": draft length is the drafter's own default (7)
