# Measured no-draft profile: the numbers in README "Measured results" were taken on this
# configuration (measured 2026-09-25 - the card is named in README > Cards tested on), with pack 2.20 bpw.
#
# Sourced by serve.sh after env.sh (PROFILE=no-draft). Any value here can still be
# overridden by exporting it before calling serve.sh.

CTX=65536            # --max-model-len: per-request ceiling actually served
CACHE_SIZE=65536     # -cs: ONE KV pool shared by all concurrent requests
AUTOSPLIT_MAX_BATCH=16   # -ambs: the loader's batch assumption; also the ceiling for...
MAX_ACTIVE_REQUESTS=16   # ...the number of requests generating at once
MAX_PENDING_REQUESTS=64
DRAFT=0              # no drafter
